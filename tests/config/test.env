; The database of the application: the queue uses it (QUEUE_DSN is empty).
DSN=sqlite::memory:
DB_USER=
DB_PASSWORD=
DB_PREFIX=

QUEUE_DSN=
QUEUE_DB_USER=
QUEUE_DB_PASSWORD=
QUEUE_DB_PREFIX=

; The tests never start a worker in the background by accident (see tests/E2E).
QUEUE_WORKER_AUTOSTART=false
QUEUE_PHP_BINARY=
