; The database of the queue table, e.g. sqlite:/var/data/queue.sqlite or mysql:host=127.0.0.1;dbname=app: see
; IQueueStorage. Empty: the database of the application, its DSN, DB_USER, DB_PASSWORD and DB_PREFIX.
QUEUE_DSN=
QUEUE_DB_USER=
QUEUE_DB_PASSWORD=
; The table name prefix in the own database.
QUEUE_DB_PREFIX=

; false: the worker is started by cron only - the queue:work command -, not by the request adding a job.
QUEUE_WORKER_AUTOSTART=true
; The PHP CLI binary the worker is started with. Empty: the one next to the PHP of the web server.
QUEUE_PHP_BINARY=
