{
  "name": "bad_cluster/runway-queue-manager",
  "type": "library",
  "description": "Background job queue for Runway: the jobs in a database table, one worker at a time, progress and cancellation",
  "keywords": ["runway", "queue", "jobs", "worker"],
  "license": "MIT",
  "authors": [
    {"name": "BaD ClusteR", "email": "admin@badcluster.ru"}
  ],
  "require": {
    "php": ">=8.4",
    "ext-json": "*",
    "ext-pdo": "*",
    "bad_cluster/runway": "dev-main",
    "bad_cluster/runway-console-app": "dev-main"
  },
  "require-dev": {
    "roave/security-advisories": "dev-latest",
    "phpunit/phpunit": "^13.4",
    "phpstan/phpstan": "^2.3",
    "infection/infection": "^0.35",
    "ext-pdo_sqlite": "*"
  },
  "autoload": {
    "psr-4": {"Runway\\QueueManager\\": "src/"},
    "files": ["bootstrap.php"]
  },
  "autoload-dev": {
    "psr-4": {"Runway\\QueueManager\\Tests\\": "tests/"}
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "test:e2e": "phpunit --testsuite e2e",
    "phpstan": "phpstan --memory-limit=1G",
    "infection": "infection --threads=max"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "config": {
    "sort-packages": true,
    "allow-plugins": {
      "infection/extension-installer": true
    }
  }
}
